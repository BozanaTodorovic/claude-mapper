{
  "name": "claude-mapper",
  "version": "0.2.0",
  "description": "Generates navigable MAP.md files and a multi-repo ARCHITECTURE.md index so AI coding agents (Claude Code and similar) stop blind-scanning your folders. Zero dependencies.",
  "type": "module",
  "bin": {
    "claude-mapper": "bin/claude-mapper.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai-agent",
    "codebase-map",
    "monorepo",
    "documentation",
    "cli",
    "architecture",
    "onboarding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlCoder/claude-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/owlCoder/claude-mapper/issues"
  },
  "homepage": "https://github.com/owlCoder/claude-mapper#readme"
}
